# xhdfe R package build configuration for Windows/Rtools.
#
# The default build is portable for the architecture selected by Rtools. Set
# XHDFE_MARCH explicitly only for local machine-specific builds.

CXX_STD = CXX17

XHDFE_MARCH ?=
XHDFE_MARCH_LABEL = $(if $(strip $(XHDFE_MARCH)),$(strip $(XHDFE_MARCH)),portable)
XHDFE_MARCH_FLAG = $(if $(strip $(XHDFE_MARCH)),-march=$(strip $(XHDFE_MARCH)),)
XHDFE_ENABLE_CUDA_CANON := $(shell printf '%s' '$(XHDFE_ENABLE_CUDA)' | tr '[:lower:]' '[:upper:]')
XHDFE_CUDA_REQUESTED := $(filter ON 1 TRUE YES AUTO,$(XHDFE_ENABLE_CUDA_CANON))

XHDFE_OPTFLAGS = -O3 -Wall $(XHDFE_MARCH_FLAG) \
    -ffast-math -fno-finite-math-only -funroll-loops -ftree-vectorize -fomit-frame-pointer \
    -fno-signed-zeros -fno-trapping-math -fassociative-math -freciprocal-math \
    $(XHDFE_CLANG_FP_FLAG)
XHDFE_CLANG_FP_FLAG = $(shell $(CXX17) -dM -E -x c++ /dev/null 2>/dev/null | grep -q '^\#define __clang__ ' && echo '-ffp-contract=off -DXHDFE_FP_CONTRACT_OFF=1')

override CXX17FLAGS += $(XHDFE_OPTFLAGS)

XHDFE_ALLOW_SERIAL_BUILD ?=
ifeq ($(strip $(XHDFE_RELEASE_BUILD)),1)
ifeq ($(strip $(XHDFE_ALLOW_SERIAL_BUILD)),1)
$(error XHDFE_RELEASE_BUILD=1 forbids XHDFE_ALLOW_SERIAL_BUILD=1)
endif
endif
# R reads Makeconf after Makevars.win. Evaluate the flags and compiler only
# once those variables exist, as in the Unix Makevars.
XHDFE_OMP_DEF = $(if $(strip $(SHLIB_OPENMP_CXXFLAGS)),-DHDFE_USE_OPENMP,)

PKG_CPPFLAGS = -I. -Iinclude -Ieigen -DNDEBUG $(XHDFE_OMP_DEF) \
    -DXHDFE_REFERENCE_MATH_CONTRACT=1 \
    -DHDFE_GPU_BACKEND_DEFAULT='"cpu"' \
    -DXHDFE_R_MARCH='"$(XHDFE_MARCH_LABEL)"' \
    -DXHDFE_R_CUDA_ARCH='""'
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS)
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS)

XHDFE_CPP_SOURCES = $(filter-out fe_absorption_cuda_certificate.cpp,$(wildcard *.cpp))
OBJECTS = $(patsubst %.cpp,%.o,$(XHDFE_CPP_SOURCES))

.PHONY: all
all: $(SHLIB)

xhdfe_openmp_gate:
	@if [ -z "$(strip $(SHLIB_OPENMP_CXXFLAGS))" ]; then \
	  if [ "$(strip $(XHDFE_ALLOW_SERIAL_BUILD))" != "1" ]; then \
	    echo "OpenMP is required; set SHLIB_OPENMP_CXXFLAGS or use XHDFE_ALLOW_SERIAL_BUILD=1 only for a diagnostic build" >&2; exit 1; \
	  fi; \
	else \
	  printf '%s\n' '#if defined(HDFE_USE_OPENMP) && !defined(_OPENMP)' '#error HDFE_USE_OPENMP requires compiler OpenMP support' '#endif' 'int main(void) { return 0; }' \
	    | $(CXX17) $(CXX17STD) $(SHLIB_OPENMP_CXXFLAGS) -DHDFE_USE_OPENMP -x c++ -c -o /dev/null - >/dev/null 2>&1 \
	    || { echo "OpenMP compile gate failed: HDFE_USE_OPENMP requires _OPENMP" >&2; exit 1; }; \
	fi

# Run on native Rtools; a cross-build that cannot execute this target cannot
# use this Makevars as release evidence.
xhdfe_fma_gate:
	@probe_dir="$$(mktemp -d)" || exit 1; \
	  trap 'rm -f "$$probe_dir/xhdfe_fma_gate.exe"; rmdir "$$probe_dir"' EXIT; \
	  printf '%s\n' \
	    '#include "include/hdfe/deterministic_parallel.hpp"' \
	    '#include <cmath>' \
	    '#include <cstdio>' \
	    'XHDFE_EXACT_FP __attribute__((noinline)) double split(double a,double b,double c){XHDFE_EXACT_FP_BODY const double p=a*b;return p+c;}' \
	    '__attribute__((noinline)) double plain(double a,double b,double c){return a*b+c;}' \
	    'int main(){volatile double e=std::ldexp(1.0,-27);volatile double a=1.0+e,b=1.0-e,c=-1.0;double f=std::fma(a,b,c),s=split(a,b,c),t=hdfe::detail::target_mul_add(a,b,c),p=plain(a,b,c);if(f!=-std::ldexp(1.0,-54)||s!=0.0||t!=p){std::fprintf(stderr,"FAIL: xhdfe R FMA contract f=%a split=%a target=%a plain=%a\n",f,s,t,p);return 1;}return 0;}' \
	    | $(CXX17) $(CXX17STD) $(CXX17FLAGS) $(PKG_CPPFLAGS) $(PKG_CXXFLAGS) -x c++ - -o "$$probe_dir/xhdfe_fma_gate.exe" \
	  && "$$probe_dir/xhdfe_fma_gate.exe" \
	  || { echo "FMA liveness gate failed for the R target" >&2; exit 1; }

$(OBJECTS): | xhdfe_openmp_gate xhdfe_fma_gate
.PHONY: xhdfe_openmp_gate xhdfe_fma_gate

ifneq ($(strip $(XHDFE_CUDA_REQUESTED)),)
$(error XHDFE_ENABLE_CUDA=$(XHDFE_ENABLE_CUDA) is not supported by the Windows R Makevars yet; install a CPU build)
endif

# Do not reuse ignored objects after a shared header or build contract changes.
XHDFE_BUILD_HEADERS = $(wildcard *.hpp include/*.hpp include/hdfe/*.hpp)
$(OBJECTS): Makevars.win $(XHDFE_BUILD_HEADERS)
